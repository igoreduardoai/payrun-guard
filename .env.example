# Rho sandbox accepts any non-empty bearer token (fictional shared dataset). Never commit a real token.
RHO_API_BASE=https://rhoapi-sandbox.rho.co/api/v1
RHO_API_TOKEN=sandbox
# Offline demo: read fixtures instead of calling the sandbox
DEMO_OFFLINE=1
FIXTURES_DIR=fixtures/rho-sandbox-2026-10-26
# Payment layer: only "simulated" exists today (Rho early-access SDK pending)
PAYMENT_RAIL=simulated
# Cash floor in cents (e.g. 2500000 = $25,000.00)
CASH_FLOOR_CENTS=2500000
# Free-tier LLM (writes text only, never amounts). Leave empty to use template text.
LLM_PROVIDER=
LLM_API_KEY=
# Secret used to sign human approval tokens (any long random string, local only)
APPROVAL_SECRET=
# Storage: Supabase is used automatically when SUPABASE_URL + SUPABASE_SECRET_KEY are set and reachable;
# otherwise (or with STORE=memory) everything runs offline in memory (Hack Fair fallback).
STORE=
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-side SECRET key (sb_secret_... or legacy service_role). Never the publishable key; never commit.
SUPABASE_SECRET_KEY=
# Only to apply migrations via the Management API (scripts/apply-migrations.ts)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
# Only for scripts/verify-live.ts (checks the public key is denied)
SUPABASE_PUBLISHABLE_KEY=
